# =====================================================================
# EVA (Enhanced Virtual Assistant) Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# =====================================================================

# Local Ollama endpoint
EVA_OLLAMA_URL=http://localhost:11434

# Primary Ollama model for chat and planning
EVA_MODEL=qwen2.5-coder:3b

# Ollama timeout in seconds (clamped between 1 and 300)
EVA_OLLAMA_TIMEOUT=120

# Model context size in tokens (must be >= 1024)
EVA_NUM_CTX=4096

# Normal chat generation token budget
EVA_NUM_PREDICT=256

# Planning and single-action generation token budget
EVA_PLANNING_NUM_PREDICT=1024

# Structured project/code generation token budget
EVA_STRUCTURED_NUM_PREDICT=2048

# Enable or disable external web search and online browsing (true/false)
EVA_ONLINE_ENABLED=true
